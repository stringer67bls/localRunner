component SBLDevAA
*-----------------------------------------------------------------------------
* <Rating>259</Rating>
*-----------------------------------------------------------------------------
SUBROUTINE SB.GET.AA.STMT.NET(EN.REC)
******************************************************************************
* Converted from : SB.GET.MG.STMT.NET
* Converted by   : Inlaks AA migration review
* Purpose        : Build AA loan statement lines for a nofile enquiry.
*********************************************************************

    $INSERT I_COMMON
    $INSERT I_EQUATE
    $INSERT I_F.ACCOUNT
    $INSERT I_F.CUSTOMER
    $INSERT I_F.STMT.ENTRY
    $INSERT I_ENQUIRY.COMMON
    $INSERT I_F.TRANSACTION
    $INSERT I_F.DATES
    $INSERT I_F.COMPANY
    $INSERT I_F.AA.ARRANGEMENT
    $INSERT I_F.AA.SETTLEMENT
    $INSERT I_F.AA.BILL.DETAILS
    $INSERT I_F.AA.PROPERTY
    $INSERT I_F.AA.ACCOUNT.DETAILS
    $INSERT I_F.AA.ARRANGEMENT.ACTIVITY

    EN.REC.TEMP = ''
    EN.REC = ''

    GOSUB INIT
    GOSUB SELECT.CRIT
    GOSUB SELECT.TMP.STMT
    GOSUB PROCESS

RETURN

*******************************************************************************
INIT:

    FN.ACCOUNT = 'F.ACCOUNT' ; F.ACCOUNT = ''
    R.ACCOUNT = ''
    CALL OPF(FN.ACCOUNT,F.ACCOUNT)

    FN.CUSTOMER = 'F.CUSTOMER' ; F.CUSTOMER = ''
    R.CUSTOMER = ''
    CALL OPF(FN.CUSTOMER,F.CUSTOMER)

    FN.TRANSACTION = 'F.TRANSACTION' ; F.TRANSACTION = ''
    R.TRANSACTION = ''
    CALL OPF(FN.TRANSACTION,F.TRANSACTION)

    FN.COMPANY = 'F.COMPANY' ; F.COMPANY = ''
    CALL OPF(FN.COMPANY,F.COMPANY)

    YR.MNE = R.COMPANY(EB.COM.MNEMONIC)

    FN.AA.ARR = 'F':YR.MNE:'.AA.ARRANGEMENT' ; F.AA.ARR = ''
    CALL OPF(FN.AA.ARR,F.AA.ARR)

    FN.AA.ARR.CURR = 'F.AA.ARRANGEMENT' ; F.AA.ARR.CURR = ''
    CALL OPF(FN.AA.ARR.CURR,F.AA.ARR.CURR)

    FN.AA.PROPERTY = 'F.AA.PROPERTY' ; F.AA.PROPERTY = ''
    CALL OPF(FN.AA.PROPERTY,F.AA.PROPERTY)

    SB.AA.DESCR.POS = ''
    CALL GET.LOC.REF('AA.PROPERTY','SB.AA.DESCR',SB.AA.DESCR.POS)

RETURN

*******************************************************************************
SELECT.CRIT:

    YR.ARR.ID = ''

    LOCATE 'AA.ID' IN D.FIELDS<1> SETTING POS1 THEN
        YR.ARR.ID = D.RANGE.AND.VALUE<POS1>
    END

    IF NOT(YR.ARR.ID) THEN
        LOCATE 'ARR.ID' IN D.FIELDS<1> SETTING POS1 THEN
            YR.ARR.ID = D.RANGE.AND.VALUE<POS1>
        END
    END

* Temporary compatibility with enquiries still passing the old field name.
    IF NOT(YR.ARR.ID) THEN
        LOCATE 'MG.ID' IN D.FIELDS<1> SETTING POS1 THEN
            YR.ARR.ID = D.RANGE.AND.VALUE<POS1>
        END
    END

    LOCATE 'START.DATE' IN D.FIELDS<1> SETTING POS1 THEN
        YR.START.DATE = D.RANGE.AND.VALUE<POS1>
    END ELSE
        YR.START.DATE = ''
    END

    LOCATE 'END.DATE' IN D.FIELDS<1> SETTING POS1 THEN
        YR.END.DATE = D.RANGE.AND.VALUE<POS1>
    END ELSE
        YR.END.DATE = ''
    END

    LOCATE 'START.INDEX' IN D.FIELDS<1> SETTING POS1 THEN
        YR.START.INDEX = D.RANGE.AND.VALUE<POS1>
    END ELSE
        YR.START.INDEX = 1
    END

    LOCATE 'END.INDEX' IN D.FIELDS<1> SETTING POS1 THEN
        YR.END.INDEX = D.RANGE.AND.VALUE<POS1>
    END ELSE
        YR.END.INDEX = 999999
    END

    LOCATE 'SORT.BY' IN D.FIELDS<1> SETTING POS1 THEN
        YR.SORT.BY = D.RANGE.AND.VALUE<POS1>
    END ELSE
        YR.SORT.BY = ''
    END

RETURN

*******************************************************************************
SELECT.TMP.STMT:

    IF NOT(YR.ARR.ID) THEN RETURN

    GOSUB READ.AA.ARRANGEMENT

    IF NOT(R.AA.ARR) THEN RETURN

    GOSUB GET.PAYIN.ACCOUNT

    YR.ACCOUNT.NUMBER = YR.PAYIN.ACCOUNT
    IF NOT(YR.ACCOUNT.NUMBER) THEN RETURN

    YAC.ID = YR.ACCOUNT.NUMBER
    YID.LIST = '' ; YR.OPEN.BAL = '' ; ER = ''
    CALL EB.ACCT.ENTRY.LIST(YR.ACCOUNT.NUMBER,YR.START.DATE,YR.END.DATE,YID.LIST,YR.OPEN.BAL,ER)

    FN.AA.BILL = 'F':YR.ARR.MNE:'.AA.BILL.DETAILS'
    F.AA.BILL = ''
    CALL OPF(FN.AA.BILL,F.AA.BILL)

    FN.AA.AD = 'F':YR.ARR.MNE:'.AA.ACCOUNT.DETAILS'
    F.AA.AD = ''
    CALL OPF(FN.AA.AD,F.AA.AD)

    R.AA.AD = '' ; AD.ERR = ''
    CALL F.READ(FN.AA.AD,YR.ARR.ID,R.AA.AD,F.AA.AD,AD.ERR)

    FN.AAA = 'F':YR.ARR.MNE:'.AA.ARRANGEMENT.ACTIVITY'
    F.AAA = ''
    CALL OPF(FN.AAA,F.AAA)

    FN.AAA.CURR = 'F.AA.ARRANGEMENT.ACTIVITY'
    F.AAA.CURR = ''
    CALL OPF(FN.AAA.CURR,F.AAA.CURR)

    YR.MNE = '' ; YCO.ID = ''
    CALL GET.ACCT.BRANCH(YAC.ID,YR.MNE,YCO.ID)

    FN.STMT.ENTRY = 'F':YR.MNE:'.STMT.ENTRY'
    R.STMT.ENTRY = '' ; F.STMT.ENTRY = ''
    CALL OPF(FN.STMT.ENTRY,F.STMT.ENTRY)

    YR.CLOSING.BAL = 0
    YR.DEBIT = '' ; YR.CREDIT = '' ; YR.ADD.BAL = ''
    LCOUNT = DCOUNT(YID.LIST,FM)

    FOR KK = 1 TO LCOUNT

        YSTMT.ID = YID.LIST<KK>
        IF NOT(YSTMT.ID) THEN CONTINUE

        R.STMT.ENTRY = '' ; ERR = ''
        CALL F.READ(FN.STMT.ENTRY,YSTMT.ID,R.STMT.ENTRY,F.STMT.ENTRY,ERR)
        IF NOT(R.STMT.ENTRY) THEN CONTINUE

        YR.DATE = R.STMT.ENTRY<AC.STE.BOOKING.DATE>

        NARR = ''
        CALL PHB.GET.NARRATIVE(YSTMT.ID,'',NARR)

        YR.TYPE = R.STMT.ENTRY<AC.STE.TRANSACTION.CODE>
        R.TRANSACTION = '' ; TXNERR = ''
        CALL F.READ(FN.TRANSACTION,YR.TYPE,R.TRANSACTION,F.TRANSACTION,TXNERR)

        YR.NARR.1 = R.TRANSACTION<AC.TRA.SHORT.DESC>
        IF YR.NARR.1 EQ '' THEN
            YR.NARR.1 = R.TRANSACTION<AC.TRA.NARRATIVE,1>
        END

        YR.NARR.2 = R.STMT.ENTRY<AC.STE.THEIR.REFERENCE,1>
        YR.NARR.3 = R.STMT.ENTRY<AC.STE.NARRATIVE><1,1>
        YR.NARR.4 = R.STMT.ENTRY<AC.STE.CHEQUE.NUMBER>
        YR.NARR.5 = R.STMT.ENTRY<AC.STE.NARRATIVE><1,2>

        YR.TXN.DETAIL = YR.NARR.1:' ':YR.NARR.2:' ':YR.NARR.5:' ':YR.NARR.3:' ':YR.NARR.4

        YR.APPL.ID = R.STMT.ENTRY<AC.STE.TRANS.REFERENCE>
        YR.SYSTEM.ID = R.STMT.ENTRY<AC.STE.SYSTEM.ID>
        YR.VALUE.DATE = R.STMT.ENTRY<AC.STE.VALUE.DATE>
        YR.CURRENCY = R.STMT.ENTRY<AC.STE.CURRENCY>
        YR.OUR.REFERENCE = R.STMT.ENTRY<AC.STE.OUR.REFERENCE>

        IF YR.CURRENCY NE LCCY THEN
            YR.AMT = R.STMT.ENTRY<AC.STE.AMOUNT.FCY>
        END ELSE
            YR.AMT = R.STMT.ENTRY<AC.STE.AMOUNT.LCY>
        END

        IF YR.AMT < 0 THEN
            YR.DEBIT = YR.AMT
            YR.CREDIT = ''
            YR.ADD.BAL = YR.DEBIT
        END ELSE
            YR.DEBIT = ''
            YR.CREDIT = YR.AMT
            YR.ADD.BAL = YR.CREDIT
        END

        YR.SPLIT.START.BAL = YR.CLOSING.BAL

        IF KK EQ 1 THEN
            YR.ADD.BAL += YR.OPEN.BAL
            YR.SPLIT.START.BAL += YR.OPEN.BAL
        END

        YR.CLOSING.BAL += YR.ADD.BAL

        R.ACCOUNT = '' ; ACERR = ''
        CALL F.READ(FN.ACCOUNT,YAC.ID,R.ACCOUNT,F.ACCOUNT,ACERR)
        YR.CUSTOMER = R.ACCOUNT<AC.CUSTOMER>

        YR.NIBB = R.ACCOUNT<AC.LOCAL.REF><1,61>
        YR.IBAN = R.ACCOUNT<AC.LOCAL.REF><1,75>
        YR.SWIFT = 'SBICMZMX'

        R.CUSTOMER = '' ; CUSERR = ''
        CALL F.READ(FN.CUSTOMER,YR.CUSTOMER,R.CUSTOMER,F.CUSTOMER,CUSERR)
        YR.CUST.NAME = R.CUSTOMER<EB.CUS.SHORT.NAME,1>
        YR.STREET = R.CUSTOMER<EB.CUS.STREET,1>
        YR.TOWN.COUNTRY = R.CUSTOMER<EB.CUS.TOWN.COUNTRY,1>

        GOSUB WRITE.STMT.LINES

        YR.DEBIT = '' ; YR.CREDIT = '' ; YR.ADD.BAL = ''

    NEXT KK

RETURN

*******************************************************************************
WRITE.STMT.LINES:

    YLOAN.MOVEMENT = 0

    GOSUB CHECK.AA.ACTIVITY.MATCH
    IF NOT(YLOAN.MOVEMENT) THEN RETURN

    GOSUB FIND.MATCHING.BILL

    IF R.AA.BILL THEN
        GOSUB WRITE.BILL.PROPERTY.LINES
    END ELSE
        GOSUB WRITE.ORIGINAL.STMT.LINE
    END

RETURN

*******************************************************************************
WRITE.ORIGINAL.STMT.LINE:

    EN.REC.TEMP<-1> = YR.DATE:'*':YR.APPL.ID:'*':YR.DEBIT:'*':YR.CREDIT:'*':YR.CLOSING.BAL:'*':YR.TXN.DETAIL:'*':YR.VALUE.DATE:'*':YR.APPL.ID:'*':YAC.ID:'*':YR.NIBB:'*':YR.IBAN:'*':YR.SWIFT:'*':YR.CUST.NAME:'*':YR.STREET:'*':YR.TOWN.COUNTRY:'*':YR.OUR.REFERENCE

RETURN

*******************************************************************************
CHECK.AA.ACTIVITY.MATCH:

    YLOAN.MOVEMENT = 0
    R.AAA = ''

    AAA.ID = YR.APPL.ID
    IF NOT(AAA.ID) THEN AAA.ID = YR.OUR.REFERENCE
    IF NOT(AAA.ID) THEN RETURN
    IF AAA.ID[1,5] NE 'AAACT' THEN RETURN

    AAA.ERR = ''
    CALL F.READ(FN.AAA,AAA.ID,R.AAA,F.AAA,AAA.ERR)

    IF NOT(R.AAA) THEN
        AAA.ERR = ''
        CALL F.READ(FN.AAA.CURR,AAA.ID,R.AAA,F.AAA.CURR,AAA.ERR)
    END

    IF R.AAA<AA.ARR.ACT.ARRANGEMENT> EQ YR.ARR.ID THEN YLOAN.MOVEMENT = 1

RETURN

*******************************************************************************
FIND.MATCHING.BILL:

    R.AA.BILL = ''
    IF NOT(YR.DEBIT) THEN RETURN
    IF NOT(YR.VALUE.DATE) THEN RETURN

    YMATCH.AMT = YR.DEBIT * -1
    IF YMATCH.AMT LE 0 THEN RETURN

    BILL.LIST = '' ; BILL.NO = '' ; BILL.ERR = ''
    SEL.BILL = 'SELECT ':FN.AA.BILL:' WITH ARRANGEMENT.ID EQ ':YR.ARR.ID:' AND WITH PAYMENT.DATE EQ ':YR.VALUE.DATE
    CALL EB.READLIST(SEL.BILL,BILL.LIST,'',BILL.NO,BILL.ERR)

    IF BILL.NO LT 1 THEN
        SEL.BILL = 'SELECT ':FN.AA.BILL:' WITH ARRANGEMENT.ID EQ ':YR.ARR.ID:' AND WITH ACTUAL.PAY.DATE EQ ':YR.VALUE.DATE
        CALL EB.READLIST(SEL.BILL,BILL.LIST,'',BILL.NO,BILL.ERR)
    END

    IF BILL.NO LT 1 THEN
        SEL.BILL = 'SELECT ':FN.AA.BILL:' WITH ARRANGEMENT.ID EQ ':YR.ARR.ID:' AND WITH FINANCIAL.DATE EQ ':YR.VALUE.DATE
        CALL EB.READLIST(SEL.BILL,BILL.LIST,'',BILL.NO,BILL.ERR)
    END

    FOR BILL.POS = 1 TO BILL.NO
        BILL.ID = BILL.LIST<BILL.POS>
        IF NOT(BILL.ID) THEN CONTINUE

        R.AA.BILL = '' ; BILL.READ.ERR = ''
        CALL F.READ(FN.AA.BILL,BILL.ID,R.AA.BILL,F.AA.BILL,BILL.READ.ERR)
        IF NOT(R.AA.BILL) THEN CONTINUE

        YBILL.TYPE = OCONV(R.AA.BILL<AA.BD.BILL.TYPE>,'MCU')
        IF YBILL.TYPE EQ 'DISBURSEMENT' THEN CONTINUE

        YOR.TOTAL = R.AA.BILL<AA.BD.OR.TOTAL.AMOUNT> + 0
        YOS.TOTAL = R.AA.BILL<AA.BD.OS.TOTAL.AMOUNT> + 0
        YPAID.TOTAL = YOR.TOTAL - YOS.TOTAL
        IF YOR.TOTAL NE YMATCH.AMT AND YPAID.TOTAL NE YMATCH.AMT THEN CONTINUE

        GOSUB GET.AD.BILL.STATUS

        IF YBILL.STATUS EQ 'SETTLED' OR YOS.TOTAL GT 0 THEN RETURN
    NEXT BILL.POS

    R.AA.BILL = ''

RETURN

*******************************************************************************
GET.AD.BILL.STATUS:

    YBILL.STATUS = ''
    IF NOT(R.AA.AD) THEN RETURN

    AD.BILL.POS = '' ; AD.BILL.SV.POS = ''
    AD.BILL.CNT = DCOUNT(R.AA.AD<AA.AD.BILL.ID>,@VM)
    IF AD.BILL.CNT LT 1 THEN AD.BILL.CNT = 1

    FOR AD.BILL.LOOP = 1 TO AD.BILL.CNT
        AD.BILL.SV.CNT = DCOUNT(R.AA.AD<AA.AD.BILL.ID,AD.BILL.LOOP>,@SM)
        IF AD.BILL.SV.CNT LT 1 THEN AD.BILL.SV.CNT = 1

        FOR AD.BILL.SV.LOOP = 1 TO AD.BILL.SV.CNT
            AD.BILL.ID = R.AA.AD<AA.AD.BILL.ID,AD.BILL.LOOP,AD.BILL.SV.LOOP>
            IF NOT(AD.BILL.ID) THEN CONTINUE

            AD.BILL.ID.NORM = AD.BILL.ID
            CONVERT '/' TO '' IN AD.BILL.ID.NORM

            IF AD.BILL.ID EQ BILL.ID OR AD.BILL.ID.NORM EQ BILL.ID THEN
                AD.BILL.POS = AD.BILL.LOOP
                AD.BILL.SV.POS = AD.BILL.SV.LOOP
                EXIT
            END
        NEXT AD.BILL.SV.LOOP

        IF AD.BILL.POS THEN EXIT
    NEXT AD.BILL.LOOP

    IF NOT(AD.BILL.POS) THEN RETURN

    YBILL.STATUS = R.AA.AD<AA.AD.BILL.STATUS,AD.BILL.POS,AD.BILL.SV.POS>
    IF NOT(YBILL.STATUS) THEN YBILL.STATUS = R.AA.AD<AA.AD.BILL.STATUS,AD.BILL.POS>
    YBILL.SM.CNT = DCOUNT(YBILL.STATUS,@SM)
    IF YBILL.SM.CNT GT 0 THEN YBILL.STATUS = FIELD(YBILL.STATUS,@SM,YBILL.SM.CNT)
    YBILL.STATUS = OCONV(YBILL.STATUS,'MCU')

RETURN

*******************************************************************************
WRITE.BILL.PROPERTY.LINES:

    PROP.CNT = DCOUNT(R.AA.BILL<AA.BD.PAY.PROPERTY>,@VM)
    IF PROP.CNT LT DCOUNT(R.AA.BILL<AA.BD.PROPERTY>,@VM) THEN PROP.CNT = DCOUNT(R.AA.BILL<AA.BD.PROPERTY>,@VM)
    IF PROP.CNT LT DCOUNT(R.AA.BILL<AA.BD.OR.PROP.AMOUNT>,@VM) THEN PROP.CNT = DCOUNT(R.AA.BILL<AA.BD.OR.PROP.AMOUNT>,@VM)
    IF PROP.CNT LT DCOUNT(R.AA.BILL<AA.BD.OR.PR.AMT>,@VM) THEN PROP.CNT = DCOUNT(R.AA.BILL<AA.BD.OR.PR.AMT>,@VM)
    IF PROP.CNT LT 1 THEN
        GOSUB WRITE.ORIGINAL.STMT.LINE
        RETURN
    END

    YSPLIT.BAL = YR.SPLIT.START.BAL
    YWROTE.PROP = 0

    FOR PROP.POS = 1 TO PROP.CNT
        PROP.SV.CNT = DCOUNT(R.AA.BILL<AA.BD.PAY.PROPERTY,PROP.POS>,@SM)
        IF PROP.SV.CNT LT DCOUNT(R.AA.BILL<AA.BD.PROPERTY,PROP.POS>,@SM) THEN PROP.SV.CNT = DCOUNT(R.AA.BILL<AA.BD.PROPERTY,PROP.POS>,@SM)
        IF PROP.SV.CNT LT DCOUNT(R.AA.BILL<AA.BD.OR.PROP.AMOUNT,PROP.POS>,@SM) THEN PROP.SV.CNT = DCOUNT(R.AA.BILL<AA.BD.OR.PROP.AMOUNT,PROP.POS>,@SM)
        IF PROP.SV.CNT LT DCOUNT(R.AA.BILL<AA.BD.OR.PR.AMT,PROP.POS>,@SM) THEN PROP.SV.CNT = DCOUNT(R.AA.BILL<AA.BD.OR.PR.AMT,PROP.POS>,@SM)
        IF PROP.SV.CNT LT 1 THEN PROP.SV.CNT = 1

        FOR PROP.SV.POS = 1 TO PROP.SV.CNT
            YPROP = R.AA.BILL<AA.BD.PAY.PROPERTY,PROP.POS,PROP.SV.POS>
            IF NOT(YPROP) THEN YPROP = R.AA.BILL<AA.BD.PROPERTY,PROP.POS,PROP.SV.POS>
            IF NOT(YPROP) THEN YPROP = R.AA.BILL<AA.BD.PAY.PROPERTY,PROP.POS>
            IF NOT(YPROP) THEN YPROP = R.AA.BILL<AA.BD.PROPERTY,PROP.POS>
            IF NOT(YPROP) THEN CONTINUE

            YPROP.AMT = R.AA.BILL<AA.BD.OR.PR.AMT,PROP.POS,PROP.SV.POS>
            IF NOT(YPROP.AMT) THEN YPROP.AMT = R.AA.BILL<AA.BD.OR.PROP.AMOUNT,PROP.POS,PROP.SV.POS>
            IF NOT(YPROP.AMT) THEN YPROP.AMT = R.AA.BILL<AA.BD.OR.PR.AMT,PROP.POS>
            IF NOT(YPROP.AMT) THEN YPROP.AMT = R.AA.BILL<AA.BD.OR.PROP.AMOUNT,PROP.POS>
            YPROP.AMT = YPROP.AMT + 0
            IF YPROP.AMT LE 0 THEN CONTINUE

            YPROP.OS = R.AA.BILL<AA.BD.OS.PR.AMT,PROP.POS,PROP.SV.POS>
            IF NOT(YPROP.OS) THEN YPROP.OS = R.AA.BILL<AA.BD.OS.PROP.AMOUNT,PROP.POS,PROP.SV.POS>
            IF NOT(YPROP.OS) THEN YPROP.OS = R.AA.BILL<AA.BD.OS.PR.AMT,PROP.POS>
            IF NOT(YPROP.OS) THEN YPROP.OS = R.AA.BILL<AA.BD.OS.PROP.AMOUNT,PROP.POS>
            YPROP.OS = YPROP.OS + 0

            YLINE.AMT = YPROP.AMT
            IF YPROP.OS GT 0 THEN YLINE.AMT = YPROP.AMT - YPROP.OS
            IF YLINE.AMT LE 0 THEN CONTINUE

            GOSUB GET.PROPERTY.DESC

            IF YPROP.OS GT 0 THEN YPROP.DESC := ' -Partial'

            YLINE.DEBIT = YLINE.AMT * -1
            YSPLIT.BAL += YLINE.DEBIT
            YWROTE.PROP = 1

            EN.REC.TEMP<-1> = YR.DATE:'*':YR.APPL.ID:'*':YLINE.DEBIT:'*':'':'*':YSPLIT.BAL:'*':YPROP.DESC:'*':YR.VALUE.DATE:'*':YR.APPL.ID:'*':YAC.ID:'*':YR.NIBB:'*':YR.IBAN:'*':YR.SWIFT:'*':YR.CUST.NAME:'*':YR.STREET:'*':YR.TOWN.COUNTRY:'*':YR.OUR.REFERENCE
        NEXT PROP.SV.POS
    NEXT PROP.POS

    IF NOT(YWROTE.PROP) THEN GOSUB WRITE.ORIGINAL.STMT.LINE

RETURN

*******************************************************************************
GET.PROPERTY.DESC:

    YPROP.DESC = YPROP
    YPROP.KEY = OCONV(YPROP,'MCU')
    YREAD.PROP = YPROP

    IF LEN(YPROP.KEY) GE 9 AND YPROP.KEY[LEN(YPROP.KEY)-8,9] EQ '-STMPDUTY' THEN
        YREAD.PROP = 'STMPDUTY'
    END

    R.AA.PROP = '' ; PROP.ERR = ''
    CALL F.READ(FN.AA.PROPERTY,YREAD.PROP,R.AA.PROP,F.AA.PROPERTY,PROP.ERR)
    IF R.AA.PROP THEN
        IF R.AA.PROP<AA.PROP.FULL.DESC,1> THEN
            YPROP.DESC = R.AA.PROP<AA.PROP.FULL.DESC,1>
        END ELSE
            IF R.AA.PROP<AA.PROP.DESCRIPTION,1> THEN YPROP.DESC = R.AA.PROP<AA.PROP.DESCRIPTION,1>
        END
    END

    YSB.AA.DESCR = ''
    IF SB.AA.DESCR.POS THEN YSB.AA.DESCR = R.AA.PROP<AA.PROP.LOCAL.REF,SB.AA.DESCR.POS>

    BEGIN CASE
        CASE YPROP.KEY EQ 'ACCOUNT'
            IF OCONV(R.AA.BILL<AA.BD.BILL.TYPE>,'MCU') EQ 'DISBURSEMENT' THEN
                YPROP.DESC = 'Loan Disbursement'
            END ELSE
                IF YSB.AA.DESCR THEN YPROP.DESC = YSB.AA.DESCR
            END
        CASE YPROP.KEY EQ 'PRINCIPALINT' OR YPROP.KEY EQ 'INSURANCEFEE' OR YPROP.KEY EQ 'FIREINS' OR YPROP.KEY EQ 'PENALTYINT'
            IF YSB.AA.DESCR THEN YPROP.DESC = YSB.AA.DESCR
        CASE YPROP.KEY EQ 'LOANORGFEE-STMPDUTY'
            IF YSB.AA.DESCR THEN YPROP.DESC = YSB.AA.DESCR:' on CSOP'
        CASE YPROP.KEY EQ 'EARLYREPAYFEE-STMPDUTY'
            IF YSB.AA.DESCR THEN YPROP.DESC = YSB.AA.DESCR
        CASE LEN(YPROP.KEY) GE 9 AND YPROP.KEY[LEN(YPROP.KEY)-8,9] EQ '-STMPDUTY'
            IF YSB.AA.DESCR THEN YPROP.DESC = YSB.AA.DESCR
        CASE 1
            IF YSB.AA.DESCR THEN YPROP.DESC = YSB.AA.DESCR
    END CASE

RETURN

*******************************************************************************
GET.PAYIN.ACCOUNT:

    YR.PAYIN.ACCOUNT = ''
    R.SETL = ''

    IF NOT(YR.ARR.MNE) THEN YR.ARR.MNE = YR.MNE
    IF NOT(YR.ARR.MNE) THEN RETURN

    FN.AA.ARR.XREF = 'F':YR.ARR.MNE:'.AA.ARRANGEMENT.DATED.XREF'
    F.AA.ARR.XREF = ''
    CALL OPF(FN.AA.ARR.XREF,F.AA.ARR.XREF)

    FN.AA.SETTLEMENT = 'F':YR.ARR.MNE:'.AA.ARR.SETTLEMENT'
    F.AA.SETTLEMENT = ''
    CALL OPF(FN.AA.SETTLEMENT,F.AA.SETTLEMENT)

    R.XREF = '' ; XREF.ERR = ''
    CALL F.READ(FN.AA.ARR.XREF,YR.ARR.ID,R.XREF,F.AA.ARR.XREF,XREF.ERR)

    IF R.XREF THEN
        ARR.PROP = R.XREF<1>
        PROP.UPD.DATE = R.XREF<5>
        LOCATE 'SETTLEMENT' IN ARR.PROP<1,1> SETTING SET.POS ELSE SET.POS = ''

        IF SET.POS THEN
            SETTL.UPD.DATES = RAISE(PROP.UPD.DATE<1,SET.POS>)
            LAST.SETTL = SETTL.UPD.DATES<1,1>
            IF LAST.SETTL THEN
                SETL.ID = YR.ARR.ID:'-SETTLEMENT-':LAST.SETTL
                SETL.ERR = ''
                CALL F.READ(FN.AA.SETTLEMENT,SETL.ID,R.SETL,F.AA.SETTLEMENT,SETL.ERR)
            END
        END
    END

    IF NOT(R.SETL) THEN
        SETL.LIST = '' ; SETL.NO = '' ; SETL.ERR = ''
        SEL.SETL = "SELECT ":FN.AA.SETTLEMENT:" WITH @ID LIKE '":YR.ARR.ID:"...'"
        CALL EB.READLIST(SEL.SETL,SETL.LIST,'',SETL.NO,SETL.ERR)
        IF SETL.NO THEN
            SETL.ID = FIELD(SETL.LIST,@FM,SETL.NO)
            SETL.ERR = ''
            CALL F.READ(FN.AA.SETTLEMENT,SETL.ID,R.SETL,F.AA.SETTLEMENT,SETL.ERR)
        END
    END

    PAYIN.LIST = R.SETL<AA.SET.PAYIN.ACCOUNT>
    PAYIN.CNT = DCOUNT(PAYIN.LIST,@VM)
    IF PAYIN.CNT LT 1 THEN PAYIN.CNT = 1

    FOR PAYIN.POS = 1 TO PAYIN.CNT
        YR.PAYIN.ACCOUNT = PAYIN.LIST<1,PAYIN.POS,1>
        IF YR.PAYIN.ACCOUNT THEN RETURN
    NEXT PAYIN.POS

RETURN

*******************************************************************************
READ.AA.ARRANGEMENT:

    R.AA.ARR = '' ; ARR.ERR = '' ; YR.ARR.MNE = ''
    CALL F.READ(FN.AA.ARR,YR.ARR.ID,R.AA.ARR,F.AA.ARR,ARR.ERR)
    IF R.AA.ARR THEN
        YR.ARR.MNE = YR.MNE
        RETURN
    END

* Some nofile enquiries run in the contract company already.  Keep a
* current-company fallback in case the company mnemonic prefix is not valid.
    ARR.ERR = ''
    CALL F.READ(FN.AA.ARR.CURR,YR.ARR.ID,R.AA.ARR,F.AA.ARR.CURR,ARR.ERR)
    IF R.AA.ARR THEN RETURN

* AA arrangements are company-scoped.  If the enquiry is launched from BNK
* or another company, locate the arrangement in the operating company first.
    SEL.CO = 'SSELECT ':FN.COMPANY:' WITH CONSOLIDATION.MARK EQ "N"'
    CO.LIST = '' ; CO.NO = '' ; CO.ERR = ''
    CALL EB.READLIST(SEL.CO,CO.LIST,'',CO.NO,CO.ERR)

    FOR CO.POS = 1 TO CO.NO
        CO.ID = CO.LIST<CO.POS>
        IF NOT(CO.ID) THEN CONTINUE

        R.CO = '' ; CO.READ.ERR = ''
        CALL F.READ(FN.COMPANY,CO.ID,R.CO,F.COMPANY,CO.READ.ERR)
        CO.MNE = R.CO<EB.COM.MNEMONIC>
        IF NOT(CO.MNE) THEN CONTINUE

        FN.AA.ARR.SCAN = 'F':CO.MNE:'.AA.ARRANGEMENT'
        F.AA.ARR.SCAN = ''
        CALL OPF(FN.AA.ARR.SCAN,F.AA.ARR.SCAN)

        R.AA.ARR = '' ; ARR.ERR = ''
        CALL F.READ(FN.AA.ARR.SCAN,YR.ARR.ID,R.AA.ARR,F.AA.ARR.SCAN,ARR.ERR)
        IF R.AA.ARR THEN
            YR.ARR.MNE = CO.MNE
            RETURN
        END
    NEXT CO.POS

RETURN

*******************************************************************************
PROCESS:

* The PAYIN account already limits the result to the settlement account.
* AA statement entries can carry AAACT activity references rather than the
* arrangement id, so no extra arrangement-id text filter is applied here.
    EN.REC.TEMP2 = EN.REC.TEMP

    YLCOUNT = DCOUNT(EN.REC.TEMP2,FM)

    IF YLCOUNT LT 1 THEN RETURN

    IF YR.END.INDEX GT YLCOUNT THEN
        YR.END.INDEX = YLCOUNT
    END

    IF YR.START.INDEX GT YLCOUNT THEN
        YR.START.INDEX = YLCOUNT
    END

    IF YR.START.INDEX LT 1 THEN YR.START.INDEX = 1
    IF YR.END.INDEX LT 1 THEN YR.END.INDEX = YLCOUNT

    IF YR.SORT.BY EQ 'DESC' THEN
        FOR I = YR.END.INDEX TO YR.START.INDEX STEP -1
            EN.REC<-1> = FIELD(EN.REC.TEMP2,FM,I)
        NEXT I
    END ELSE
        FOR J = YR.START.INDEX TO YR.END.INDEX
            EN.REC<-1> = FIELD(EN.REC.TEMP2,FM,J)
        NEXT J
    END

RETURN
