$PACKAGE SBLDevAA
*-----------------------------------------------------------------------------
SUBROUTINE E.AA.PRIME.RATE
******************************************************************************
* Enquiry conversion routine.
*
* Input  : O.DATA = AA arrangement id
* Output : O.DATA = latest BASIC.INTEREST rate for the arrangement's
*                 PRINCIPALINT floating/periodic index and currency.
*
* Example BASIC.INTEREST id lookup:
*   FLOATING.INDEX = 47, CURRENCY = MZN, selected id starts 47MZN...
******************************************************************************

    $INSERT I_COMMON
    $INSERT I_EQUATE
    $INSERT I_ENQUIRY.COMMON
    $INSERT I_F.COMPANY
    $INSERT I_F.AA.ARRANGEMENT
    $INSERT I_F.AA.INTEREST
    $INSERT I_F.BASIC.INTEREST

    GOSUB INIT
    GOSUB PROCESS
RETURN

INIT:
    ARR.ID = O.DATA
    O.DATA = ''

    PRIME.RATE = ''
    MNE = R.COMPANY(EB.COM.MNEMONIC)
    IF NOT(MNE) THEN MNE = ''

    FN.COMPANY = 'F.COMPANY' ; F.COMPANY = ''
    CALL OPF(FN.COMPANY,F.COMPANY)

    FN.BASIC.INTEREST = 'F.BASIC.INTEREST' ; F.BASIC.INTEREST = ''
    CALL OPF(FN.BASIC.INTEREST,F.BASIC.INTEREST)

RETURN

PROCESS:
    IF NOT(ARR.ID) THEN RETURN


    GOSUB OPEN.AA.FILES
    GOSUB GET.RATE.FOR.COMPANY
    IF PRIME.RATE NE '' THEN
        O.DATA = PRIME.RATE
        RETURN
    END

    SEL.CO = 'SELECT ':FN.COMPANY:' WITH CONSOLIDATION.MARK EQ "N"'
    CO.LIST = '' ; CO.NO = '' ; CO.ERR = ''
    CALL EB.READLIST(SEL.CO,CO.LIST,'',CO.NO,CO.ERR)

    FOR CO.POS = 1 TO CO.NO
        CO.ID = CO.LIST<CO.POS>
        R.CO = '' ; CO.READ.ERR = ''
        CALL F.READ(FN.COMPANY,CO.ID,R.CO,F.COMPANY,CO.READ.ERR)
        CO.MNE = R.CO<EB.COM.MNEMONIC>
        IF NOT(CO.MNE) THEN CONTINUE
        IF CO.MNE EQ MNE THEN CONTINUE

        MNE.SAVE = MNE
        MNE = CO.MNE
        GOSUB OPEN.AA.FILES
        GOSUB GET.RATE.FOR.COMPANY
        MNE = MNE.SAVE

        IF PRIME.RATE NE '' THEN EXIT
    NEXT CO.POS

    O.DATA = PRIME.RATE
RETURN

OPEN.AA.FILES:
    FN.AA.ARR = 'F':MNE:'.AA.ARRANGEMENT' ; F.AA.ARR = ''
    CALL OPF(FN.AA.ARR,F.AA.ARR)

    FN.AA.XREF = 'F':MNE:'.AA.ARRANGEMENT.DATED.XREF' ; F.AA.XREF = ''
    CALL OPF(FN.AA.XREF,F.AA.XREF)

    FN.AA.ARR.INT = 'F':MNE:'.AA.ARR.INTEREST' ; F.AA.ARR.INT = ''
    CALL OPF(FN.AA.ARR.INT,F.AA.ARR.INT)

RETURN

GET.RATE.FOR.COMPANY:
    R.ARR = '' ; ARR.ERR = ''
    CALL F.READ(FN.AA.ARR,ARR.ID,R.ARR,F.AA.ARR,ARR.ERR)
    IF NOT(R.ARR) THEN RETURN

    ARR.CCY = R.ARR<AA.ARR.CURRENCY>
    IF NOT(ARR.CCY) THEN RETURN

    R.XREF = '' ; XREF.ERR = ''
    CALL F.READ(FN.AA.XREF,ARR.ID,R.XREF,F.AA.XREF,XREF.ERR)
    IF NOT(R.XREF) THEN RETURN

    XREF.PROPS = R.XREF<1>
    XREF.UPD.DATES = R.XREF<5>

    LOCATE 'PRINCIPALINT' IN XREF.PROPS<1,1> SETTING INT.POS ELSE INT.POS = ''
    IF NOT(INT.POS) THEN RETURN

    INT.UPD.DATES = RAISE(XREF.UPD.DATES<1,INT.POS>)
    LAST.INT.DATE = INT.UPD.DATES<1,1>
    IF NOT(LAST.INT.DATE) THEN RETURN

    INT.ID = ARR.ID:'-PRINCIPALINT-':LAST.INT.DATE
    R.INT = '' ; INT.ERR = ''
    CALL F.READ(FN.AA.ARR.INT,INT.ID,R.INT,F.AA.ARR.INT,INT.ERR)
    IF NOT(R.INT) THEN RETURN

    FLOATING.INDEX = R.INT<AA.INT.FLOATING.INDEX>
    IF NOT(FLOATING.INDEX) THEN FLOATING.INDEX = R.INT<AA.INT.PERIODIC.INDEX>
    IF NOT(FLOATING.INDEX) THEN RETURN

    GOSUB GET.BASIC.INTEREST.RATE
RETURN

GET.BASIC.INTEREST.RATE:
    BI.PREFIX = FLOATING.INDEX:ARR.CCY
    BI.LIST = '' ; BI.NO = '' ; BI.ERR = ''
    SEL.BI = 'SELECT ':FN.BASIC.INTEREST:' WITH @ID LIKE ':BI.PREFIX:'... BY @ID'
    CALL EB.READLIST(SEL.BI,BI.LIST,'',BI.NO,BI.ERR)
    IF BI.NO LT 1 THEN RETURN

    BI.ID = BI.LIST<BI.NO>
    R.BI = '' ; BI.ERR = ''
    CALL F.READ(FN.BASIC.INTEREST,BI.ID,R.BI,F.BASIC.INTEREST,BI.ERR)
    IF R.BI THEN PRIME.RATE = R.BI<EB.BIN.INTEREST.RATE>
RETURN

END
